module nx1mux(i,s,y);
    parameter N=20;
	parameter SEL=$clog2(N);
	input [N-1:0]i;
	output y;
	input [SEL-1:0]s;
	assign y=i[s];
endmodule 
module top;
    parameter N=20;
	parameter SEL=$clog2(N);
	reg [N-1:0]i;
	wire y;
	reg [SEL-1:0]s;
    nx1mux #(.SEL(SEL),.N(N))dut(i,s,y);
	initial begin
	  repeat(10)begin
	   i=$random;
	   s=$urandom_range(0,N-1);
	   #1;
	   $display("i=%b s=%b y=%b",i,s,y);
	  end
	end
	endmodule 
