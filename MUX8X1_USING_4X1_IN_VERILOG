module mux_4x1(i,s,y);
   input [3:0]i;
   input [1:0]s;
   output y;
     assign y=i[s];
endmodule 

module mux_8x1(i,s,y);
    input [7:0]i;
	input [2:0]s;
	output y;
	wire [1:0]n;
    mux_4x1 m1(i[3:0],s[1:0],n[0]);
    mux_4x1 m2(i[7:4],s[1:0],n[1]);
    mux_4x1 m3({n[1],1'b0,1'b0,n[0]},{s[2],s[2]},y);
endmodule 

module top;
    reg [7:0]i;
	reg [2:0]s;
	wire y;

    mux_8x1 dut(i,s,y);
	initial begin
	   repeat(10)begin
	      {i,s}=$random;
		  #1;
		  $display("i=%b s=%b y=%b",i,s,y);
	   end
	end
endmodule 







